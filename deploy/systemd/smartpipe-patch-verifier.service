[Unit]
Description=SmartPipe patch verifier and release builder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smartpipe
Group=smartpipe
WorkingDirectory=@INSTALL_DIR@/bin
EnvironmentFile=/etc/smartpipe/smartpipe.env
Environment=SMARTPIPE_VERIFY_ADDR=:8095
Environment=SMARTPIPE_VERIFY_WORK_ROOT=@STATE_DIR@/verify/work
Environment=SMARTPIPE_WORKSPACE_ROOT=@STATE_DIR@/verify/workspaces
Environment=SMARTPIPE_RELEASE_WORK_ROOT=@STATE_DIR@/verify/releases
Environment=SMARTPIPE_RELEASE_OUTPUT_ROOT=@STATE_DIR@/releases
Environment=GOPATH=@STATE_DIR@/go
Environment=GOCACHE=@STATE_DIR@/go-cache
Environment=npm_config_cache=@STATE_DIR@/npm
ExecStart=@INSTALL_DIR@/bin/patch-verifier
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@STATE_DIR@
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
