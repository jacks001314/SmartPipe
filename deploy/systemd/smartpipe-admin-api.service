[Unit]
Description=SmartPipe admin API and web console
After=network-online.target smartpipe-patch-verifier.service
Wants=network-online.target
Requires=smartpipe-patch-verifier.service

[Service]
Type=simple
User=smartpipe
Group=smartpipe
WorkingDirectory=@INSTALL_DIR@
EnvironmentFile=/etc/smartpipe/smartpipe.env
Environment=SMARTPIPE_ADMIN_ADDR=:8092
Environment=SMARTPIPE_WEB_DIST=@INSTALL_DIR@/web
Environment=SMARTPIPE_VERIFY_URL=http://127.0.0.1:8095
Environment=SMARTPIPE_RELEASE_URL=http://127.0.0.1:8095
Environment=SMARTPIPE_BOT_ADDR=http://127.0.0.1:8093
ExecStart=@INSTALL_DIR@/bin/admin-api
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@STATE_DIR@
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
