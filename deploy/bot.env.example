# 蓝信个人机器人凭证（真实值放 bot.local.env，勿提交）
# 获取：蓝信桌面端 -> 通讯录 -> 智能机器人 -> 个人机器人 -> ℹ️
LANXIN_APP_ID=orgId-appId
LANXIN_APP_SECRET=your-app-secret

# API 网关：公有云默认 https://open.e.lanxin.cn/open/apigw
# 企业私有部署由管理员提供，例如：
# LANXIN_API_BASE=https://apigw.lx.qianxin.com
LANXIN_API_BASE=https://open.e.lanxin.cn/open/apigw

# bot 服务 HTTP 监听（healthz 等）
BOT_HTTP_ADDR=:8091

# 编排层地址（可选；为空时 bot 使用本地回执占位）
# ORCHESTRATOR_URL=http://127.0.0.1:8090

# 内网接口共享令牌（bot / orchestrator 两边一致；为空不校验）
# INTERNAL_TOKEN=dev-token

# 群聊是否仅 @机器人 时响应
BOT_REQUIRE_AT_ME=true
