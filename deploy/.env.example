# SmartPipe 部署环境模板。
# 复制为 deploy/.env 后填写；也可以让 scripts/install.sh 根据参数自动生成随机令牌和主密钥。
# deploy/.env 含真实凭据，权限应为 600，且不得提交到 Git。

# ---------------------------------------------------------------------------
# 必填：数据库与加密主密钥
# ---------------------------------------------------------------------------
# Postgres 必须可被容器访问。URL 中的特殊字符需要百分号编码。
SMARTPIPE_DSN=postgres://smartpipe:CHANGE_ME@192.168.1.99:5432/smartpipe?sslmode=disable

# AES-256-GCM 主密钥。必须恰好为随机 32 字节的 base64，例如：
#   openssl rand -base64 32
# 该密钥丢失后，配置台里已保存的 GitHub / 蓝信凭据无法解密。
SMARTPIPE_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# ---------------------------------------------------------------------------
# 必填：服务间内部令牌。建议各用 32 字节以上随机值：
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
SMARTPIPE_ADMIN_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN
# 控制台登录账号（密码留空则只支持管理员令牌/Bearer）
SMARTPIPE_ADMIN_USER=admin
SMARTPIPE_ADMIN_PASSWORD=
SMARTPIPE_SESSION_TTL=12h
SMARTPIPE_COOKIE_SECURE=false
SMARTPIPE_BRIDGE_TOKEN=REPLACE_WITH_RANDOM_BRIDGE_TOKEN
SMARTPIPE_VERIFY_TOKEN=REPLACE_WITH_RANDOM_VERIFY_TOKEN
SMARTPIPE_RELEASE_TOKEN=REPLACE_WITH_RANDOM_RELEASE_TOKEN
SMARTPIPE_BOT_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_BOT_TOKEN
SMARTPIPE_CRASH_TOKEN=REPLACE_WITH_RANDOM_CRASH_TOKEN
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_GITHUB_WEBHOOK_SECRET

# bot 进程读取下列变量；Compose 也执行同一组值。
INTERNAL_TOKEN=REPLACE_WITH_RANDOM_BOT_TOKEN
BRIDGE_TOKEN=REPLACE_WITH_RANDOM_BRIDGE_TOKEN
CRASH_INGEST_TOKEN=REPLACE_WITH_RANDOM_CRASH_TOKEN

# ---------------------------------------------------------------------------
# 必填：蓝信机器人
# ---------------------------------------------------------------------------
LANXIN_APP_ID=orgId-appId
LANXIN_APP_SECRET=REPLACE_WITH_LANXIN_APP_SECRET
LANXIN_API_BASE=https://open.e.lanxin.cn/open/apigw
BOT_REQUIRE_AT_ME=true

# ---------------------------------------------------------------------------
# 运行参数
# ---------------------------------------------------------------------------
SMARTPIPE_VERSION=0.1.0
SMARTPIPE_COMMIT=unknown
SMARTPIPE_BIND_ADDR=0.0.0.0
SMARTPIPE_ADMIN_PORT=8092
SMARTPIPE_BRIDGE_PORT=8090
SMARTPIPE_BOT_PORT=8093
SMARTPIPE_VERIFY_PORT=8095

# App Server 仅在由 SmartPipe 自动派生 lead Agent 时填写。
# 项目绑定里配置的地址优先；这里可作为默认值。
SMARTPIPE_APPSERVER_ADDR=
SMARTPIPE_APPSERVER_TOKEN=

# 计划发版默认关闭，避免新部署后自动创建 tag。
SMARTPIPE_RELEASE_SCHEDULE=off
SMARTPIPE_CRASH_RETENTION_DAYS=30
SMARTPIPE_CRASH_REJECT_RETENTION_DAYS=7
SMARTPIPE_CRASH_RETENTION_HOURS=6
SMARTPIPE_VERIFY_CONCURRENCY=2
SMARTPIPE_VERIFY_TIMEOUT=30m

# 群未绑项目时的崩溃上报兜底项目 ID；留空则要求消息里带项目或按群反查。
CRASH_PROJECT_ID=
SMARTPIPE_CRASH_PROJECT=
